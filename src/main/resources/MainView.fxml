<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.MainController" spacing="10">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="90"/>
            <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
        </columnConstraints>
        <Label text="%language.label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="languageBox" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="%category.label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="categoryBox" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="%from.label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="fromUnitBox" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="%to.label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="toUnitBox" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="descriptionLabel" wrapText="true" style="-fx-text-fill: #555555;"/>
    <TextField fx:id="inputField" promptText="%input.prompt" onAction="#handleConvert"/>
    <Button text="%convert.button" onAction="#handleConvert" defaultButton="true"/>
    <Label fx:id="resultLabel" wrapText="true" style="-fx-font-weight: bold;"/>
    <Label text="%history.label"/>
    <ListView fx:id="historyList" prefHeight="140"/>
    <Label fx:id="statusLabel" wrapText="true" style="-fx-text-fill: #b00020;"/>
</VBox>
